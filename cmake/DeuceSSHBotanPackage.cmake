# Botan's C++ ABI is not guaranteed across releases. Record the headers used
# by each successful library build; installation never consults newer headers.

function(dssh_botan_header_version result)
	set(header "")
	foreach(directory IN LISTS ARGN)
		if(EXISTS "${directory}/botan/build.h")
			set(header "${directory}/botan/build.h")
			break()
		endif()
	endforeach()
	if(NOT header)
		message(FATAL_ERROR "Cannot record Botan binary dependency: botan/build.h is missing")
	endif()
	file(STRINGS "${header}" definitions
		REGEX "^[ \t]*#[ \t]*define[ \t]+BOTAN_VERSION_(MAJOR|MINOR|PATCH)([ \t]|$)")
	foreach(component IN ITEMS MAJOR MINOR PATCH)
		set(values "")
		foreach(definition IN LISTS definitions)
			if(definition MATCHES "^[ \t]*#[ \t]*define[ \t]+BOTAN_VERSION_${component}([ \t]|$)")
				list(APPEND values "${definition}")
			endif()
		endforeach()
		list(LENGTH values count)
		if(NOT count EQUAL 1 OR NOT values MATCHES "^[ \t]*#[ \t]*define[ \t]+BOTAN_VERSION_${component}[ \t]+(0|[1-9][0-9]*)[ \t]*$")
			message(FATAL_ERROR "Invalid BOTAN_VERSION_${component} in ${header}")
		endif()
		set(${component} "${CMAKE_MATCH_1}")
	endforeach()
	set(${result} "${MAJOR}.${MINOR}.${PATCH}" PARENT_SCOPE)
endfunction()

function(dssh_write_botan_package version base output)
	if(NOT version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
		message(FATAL_ERROR "Invalid recorded Botan binary version")
	endif()
	# Validate every input before publishing any output.
	set(files deucesshConfig.cmake deucessh.pc)
	if(EXISTS "${base}/deucessh-static.pc")
		list(APPEND files deucessh-static.pc)
	endif()
	foreach(name IN LISTS files)
		file(READ "${base}/${name}" contents)
		if(NOT contents MATCHES "DSSH_BOTAN_BINARY_VERSION")
			message(FATAL_ERROR "Missing Botan binary version placeholder in ${name}")
		endif()
		string(REPLACE "DSSH_BOTAN_BINARY_VERSION" "${version}" prepared "${contents}")
		set(content_${name} "${prepared}")
	endforeach()
	file(MAKE_DIRECTORY "${output}")
	foreach(name IN LISTS files)
		set(contents "${content_${name}}")
		file(CONFIGURE OUTPUT "${output}/${name}" CONTENT "@contents@" @ONLY)
	endforeach()
	file(CONFIGURE OUTPUT "${output}/version.txt" CONTENT "@version@\n" @ONLY)
endfunction()

function(dssh_configure_botan_package)
	set(package_root "${CMAKE_CURRENT_BINARY_DIR}/botan-package")
	set(base "${DSSH_PACKAGE_TEMPLATE_DIR}")
	file(CONFIGURE OUTPUT "${package_root}/build-inputs.txt"
		CONTENT "${DEUCESSH_BOTAN_MIN_VERSION}\n${DEUCESSH_BOTAN_VERSION}\n${DSSH_CRYPTO_INCLUDE}\n${BOTAN3_VENDORED_TARGET}\n" @ONLY)
	set(records "")
	set(anchor "")
	foreach(target IN LISTS DEUCESSH_INSTALL_TARGETS)
		set(output "${package_root}/${target}/$<CONFIG>")
		set(byproducts "${output}/version.txt" "${output}/deucesshConfig.cmake"
			"${output}/deucessh.pc")
		if(DEUCESSH_BUILD_STATIC)
			list(APPEND byproducts "${output}/deucessh-static.pc")
		endif()
		list(APPEND records "${output}/version.txt")
		set(step "cmake_minimum_required(VERSION 3.22)\ninclude([==[${CMAKE_CURRENT_FUNCTION_LIST_FILE}]==])\n")
		string(APPEND step "dssh_botan_header_version(version [==[${DSSH_CRYPTO_INCLUDE}]==])\n")
		string(APPEND step "if(version VERSION_LESS [==[${DEUCESSH_BOTAN_MIN_VERSION}]==])\nmessage(FATAL_ERROR \"Botan headers are below the source-build minimum\")\nendif()\n")
		if(NOT BOTAN3_VENDORED_TARGET)
			string(APPEND step "if(NOT version STREQUAL [==[${DEUCESSH_BOTAN_VERSION}]==])\nmessage(FATAL_ERROR \"Botan header and pkg-config versions disagree\")\nendif()\n")
		endif()
		string(APPEND step "dssh_write_botan_package(\"\${version}\" [==[${base}]==] [==[${output}]==])\n")
		file(GENERATE OUTPUT "${package_root}/${target}-$<CONFIG>.cmake"
			CONTENT "${step}" TARGET ${target})
		add_custom_command(TARGET ${target} POST_BUILD
			BYPRODUCTS ${byproducts}
			COMMAND "${CMAKE_COMMAND}" -P "${package_root}/${target}-$<CONFIG>.cmake"
			COMMENT "Recording the compiled Botan dependency for ${target}"
			VERBATIM)
		if(NOT anchor)
			set(anchor "${output}")
		endif()
	endforeach()
	# Changing metadata must refresh the successful-build records, even when
	# the compiler inputs would otherwise be unchanged. Version headers are
	# already dependencies of this translation unit through Botan's headers.
	set(dependencies "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
		"${package_root}/build-inputs.txt"
		"${base}/deucesshConfig.cmake" "${base}/deucessh.pc")
	if(DEUCESSH_BUILD_STATIC)
		list(APPEND dependencies "${base}/deucessh-static.pc")
	endif()
	set_property(SOURCE crypto/botan.cpp APPEND PROPERTY OBJECT_DEPENDS "${dependencies}")
	set(check "set(records [==[${records}]==])\nset(version \"\")\n")
	string(APPEND check [=[
foreach(record IN LISTS records)
	if(NOT EXISTS "${record}")
		message(FATAL_ERROR "Build every enabled DeuceSSH library before installing: ${record}")
	endif()
	file(READ "${record}" current)
	if(NOT current MATCHES "^[0-9]+[.][0-9]+[.][0-9]+\n$")
		message(FATAL_ERROR "Invalid Botan successful-build record: ${record}")
	endif()
	if(version AND NOT current STREQUAL version)
		message(FATAL_ERROR "Enabled DeuceSSH libraries were built with different Botan versions; rebuild before installing")
	endif()
	set(version "${current}")
endforeach()
]=])
	file(GENERATE OUTPUT "${package_root}/check-$<CONFIG>.cmake" CONTENT "${check}")
	set(DSSH_PACKAGE_INSTALL_DIR "${anchor}" PARENT_SCOPE)
endfunction()
