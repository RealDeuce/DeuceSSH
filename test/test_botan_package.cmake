cmake_minimum_required(VERSION 3.22)
include("${DSSH_SOURCE}/cmake/DeuceSSHBotanPackage.cmake")

if(DEFINED DSSH_PACKAGE_CHILD)
	dssh_botan_header_version(version "${DSSH_WORK}/include")
	dssh_write_botan_package("${version}" "${DSSH_WORK}/base" "${DSSH_WORK}/output")
	return()
endif()

file(MAKE_DIRECTORY "${DSSH_WORK}/base" "${DSSH_WORK}/include/botan")
foreach(name IN ITEMS deucesshConfig.cmake deucessh.pc deucessh-static.pc)
	file(WRITE "${DSSH_WORK}/base/${name}" "dependency=DSSH_BOTAN_BINARY_VERSION\n")
endforeach()
set(header "${DSSH_WORK}/include/botan/build.h")
set(valid "#define BOTAN_VERSION_MAJOR 3\n#define BOTAN_VERSION_MINOR 14\n#define BOTAN_VERSION_PATCH 1\n")
set(checks 0)

function(run_case name succeeds)
	execute_process(COMMAND "${CMAKE_COMMAND}"
		"-DDSSH_SOURCE=${DSSH_SOURCE}" "-DDSSH_WORK=${DSSH_WORK}"
		-DDSSH_PACKAGE_CHILD=ON -P "${CMAKE_CURRENT_LIST_FILE}"
		RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
	if(succeeds)
		if(NOT status STREQUAL "0")
			message(FATAL_ERROR "${name} failed: ${output}${error}")
		endif()
	else()
		if(status STREQUAL "0")
			message(FATAL_ERROR "${name} unexpectedly succeeded")
		endif()
		foreach(file IN ITEMS deucesshConfig.cmake deucessh.pc deucessh-static.pc version.txt)
			file(READ "${DSSH_WORK}/output/${file}" actual)
			if(NOT actual STREQUAL "sentinel\n")
				message(FATAL_ERROR "${name} changed ${file} after refusal")
			endif()
		endforeach()
	endif()
	math(EXPR next "${checks} + 1")
	set(checks "${next}" PARENT_SCOPE)
endfunction()

# The headers can first appear after configure, as in an ExternalProject build.
foreach(name IN ITEMS deucesshConfig.cmake deucessh.pc deucessh-static.pc version.txt)
	file(WRITE "${DSSH_WORK}/output/${name}" "sentinel\n")
endforeach()
file(REMOVE "${header}")
run_case(missing_header FALSE)
foreach(bad IN ITEMS "" "#define BOTAN_VERSION_MAJOR 3\n"
	"#define BOTAN_VERSION_MAJOR 3\n#define BOTAN_VERSION_MINOR invalid\n#define BOTAN_VERSION_PATCH 1\n"
	"#define BOTAN_VERSION_MAJOR 3\n#define BOTAN_VERSION_MINOR -1\n#define BOTAN_VERSION_PATCH 1\n"
	"#define BOTAN_VERSION_MAJOR 3\n#define BOTAN_VERSION_MINOR 014\n#define BOTAN_VERSION_PATCH 1\n"
	"${valid}#define BOTAN_VERSION_PATCH 2\n"
	"${valid}#define BOTAN_VERSION_PATCH invalid\n")
	file(WRITE "${header}" "${bad}")
	run_case(malformed_header FALSE)
endforeach()
file(WRITE "${header}" "${valid}")
file(WRITE "${DSSH_WORK}/base/deucessh-static.pc" "missing placeholder\n")
run_case(malformed_template FALSE)
file(WRITE "${DSSH_WORK}/base/deucessh-static.pc" "dependency=DSSH_BOTAN_BINARY_VERSION\n")
run_case(deferred_headers_available TRUE)
foreach(name IN ITEMS deucesshConfig.cmake deucessh.pc deucessh-static.pc)
	file(READ "${DSSH_WORK}/output/${name}" actual)
	if(NOT actual STREQUAL "dependency=3.14.1\n")
		message(FATAL_ERROR "Incorrect compiled dependency in ${name}")
	endif()
endforeach()
file(READ "${DSSH_WORK}/output/version.txt" actual)
if(NOT actual STREQUAL "3.14.1\n")
	message(FATAL_ERROR "Incorrect successful-build version")
endif()
file(TIMESTAMP "${DSSH_WORK}/output/deucessh.pc" before "%s")
run_case(repeated_generation TRUE)
file(TIMESTAMP "${DSSH_WORK}/output/deucessh.pc" after "%s")
if(NOT before STREQUAL after)
	message(FATAL_ERROR "Unchanged metadata was rewritten")
endif()
message(STATUS "botan_package checks=${checks} failed=0")
